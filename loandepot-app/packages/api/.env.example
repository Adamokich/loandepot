# Порт, на котором запускается бэкенд приложения (Express)
PORT=8000

# Ссылка для подключения к MongoDB Atlas
# Для подставки использовать ссылку на свой кластер (тестовый)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/loandepot?retryWrites=true&w=majority

# URL фронтенд-приложения для настройки политики CORS
CLIENT_URL = http://localhost:5173